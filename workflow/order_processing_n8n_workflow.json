      "id": "c702ddc3-ed0b-4e50-9fe3-c25c625c2439",
      "name": "Receive New Order",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        -1100,
        0
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "new-customer-order",
        "authentication": "headerAuth",
        "responseMode": "responseNode",
        "options": {}
      },
      "webhookId": "retail-order-demo"
    },
    {
      "id": "12076fe5-eeca-4f78-b5d4-eded41e38091",
      "name": "Validate & Normalize Order",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -860,
        0
      ],
      "parameters": {
        "jsCode": "// Runs once per incoming POST webhook event.\nconst incoming = $input.first().json;\nconst data = incoming.body && typeof incoming.body === 'object' && !Array.isArray(incoming.body)\n  ? incoming.body : incoming;\nconst errors = [];\nconst str = (v, max) => String(v ?? '').trim().replace(/[\\x00-\\x08\\x0B\\x0C\\x0E-\\x1F]/g, '').slice(0, max);\nconst order_id = str(data.order_id, 64);\nconst customer_name = str(data.customer_name, 120);\nconst customer_email = str(data.customer_email, 254).toLowerCase();\nconst product = str(data.product, 180);\nconst notes = str(data.notes, 500);\nconst currency = str(data.currency ?? 'USD', 3).toUpperCase();\nconst quantity = Number(data.quantity);\nconst unit_price = Number(data.unit_price);\n\nif (!/^[a-zA-Z0-9_-]{1,64}$/.test(order_id)) errors.push('order_id must be 1-64 letters, numbers, _ or -');\nif (!customer_name) errors.push('customer_name is required');\nif (!/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(customer_email)) errors.push('customer_email must be valid');\nif (!product) errors.push('product is required');\nif (!Number.isInteger(quantity) || quantity < 1 || quantity > 10000) errors.push('quantity must be an integer between 1 and 10000');\nif (data.unit_price === '' || data.unit_price == null || !Number.isFinite(unit_price) || unit_price < 0 || unit_price > 1000000000) errors.push('unit_price must be a number from 0 to 1000000000');\nif (!/^[A-Z]{3}$/.test(currency)) errors.push('currency must be a three-letter code');\n\nconst valid = errors.length === 0;\nreturn [{json: {\n  valid,\n  errors,\n  received_at: new Date().toISOString(),\n  order_id,\n  customer_name,\n  customer_email,\n  product,\n  quantity: valid ? quantity : null,\n  unit_price: valid ? unit_price : null,\n  currency,\n  total_amount: valid ? Math.round(quantity * unit_price * 100) / 100 : null,\n  notes\n}}];",
        "mode": "runOnceForAllItems"
      }
    },
    {
      "id": "ccc2f969-3d15-440b-a387-a3d3c6e5a9fc",
      "name": "Order Valid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        -620,
